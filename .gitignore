# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.txt
coverage.html
*.prof

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Environment variables file
.env
.env.*
!.env.example

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
._*
Thumbs.db
Desktop.ini

# Python artifacts (scripts/ & packaging/)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Microsoft Office temporary lock files
~$*.docx
~$*.xlsx
~$*.pptx

# Browser automation debug artifacts
/.playwright-mcp/

# Croc builds
/croc
/croc-web
/croc-update
croc_v*
bin/
src/croc/test-*
tmp/

# Generated only when building the standalone croc-web binary.
/src/webassets/dist/*
!/src/webassets/dist/.gitkeep
croc2

# Tài liệu kế hoạch cục bộ
Ke_Hoach_Chi_Tiet_Folder_Sync.md
Ke_Hoach_Phan_Cong_Dong_Bo_Thu_Muc.docx
